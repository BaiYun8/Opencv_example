{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MSVC 编译 OpenCV + ONNX",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "${file}",
                "/Fe:${fileDirname}/${fileBasenameNoExtension}.exe",

                "/I", "F:/opencv/opencv/build/x64/install/include",
                "/I", "F:/onnxruntime/onnxruntime-win-x64-gpu-1.16.3/onnxruntime-win-x64-gpu-1.16.3/include",

                "/link",
                "/LIBPATH:F:/opencv/opencv/build/x64/install/x64/vc17/lib",
                "/LIBPATH:F:/onnxruntime/onnxruntime-win-x64-gpu-1.16.3/onnxruntime-win-x64-gpu-1.16.3/lib",
                "opencv_world4120.lib",
                "onnxruntime.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$msCompile"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}